import './style.css';
import {createRoot} from 'react-dom/client';
import {useState,useEffect,useMemo,useRef} from 'react';
import {GraduationCap,LayoutDashboard,CalendarDays,ChartNoAxesCombined,BookOpen,Brain,UserRound,FileBadge,Settings,Sun,Moon,Menu,X,ArrowUpRight,ArrowRight,ShieldCheck,Activity,Clock3,MapPin,ChevronDown,RefreshCw,Download,AlertCircle,CheckCircle2,ExternalLink,Lock,Send,MessageCircle,BookOpenCheck,Calculator,Target,PanelLeftClose,PanelLeftOpen,Search,LogOut,CalendarCheck,ClipboardList, Sparkles} from 'lucide-react';

const ERP_URL='https://erp.sathyabama.ac.in/';
const NAV=[
  {group:'CAMPUS',items:[['Home',LayoutDashboard],['Attendance',ChartNoAxesCombined],['Timetable',CalendarDays]]},
  {group:'ACADEMICS',items:[['Results',BookOpen],['SIST AI',Brain],['Hall ticket',FileBadge]]},
  {group:'ACCOUNT',items:[['Profile',UserRound],['Settings',Settings]]}
];
const STEPS=[
  {title:'Opening the official ERP',detail:'A separate window opens at erp.sathyabama.ac.in.'},
  {title:'Complete your ERP sign-in',detail:'Use the original ERP login and its normal security check.'},
  {title:'Linking your student session',detail:'The portal receives the approved session hand-off.'}
];
const iconMap={Home:LayoutDashboard,Attendance:ChartNoAxesCombined,Timetable:CalendarDays,Results:BookOpen,'SIST AI':Brain,'Hall ticket':FileBadge,Profile:UserRound,Settings};
const getArray=v=>Array.isArray(v)?v:[];
const pct=v=>Math.max(0,Math.min(100,Number(v)||0));
const initials=name=>String(name||'Student').split(/\s+/).slice(0,2).map(x=>x[0]).join('').toUpperCase();

function Stat({label,value,sub,icon:Icon,accent='gold'}){return <article className={`stat-card ${accent}`}><div className="stat-top"><span>{label}</span><Icon size={17}/></div><strong>{value??'—'}</strong><small>{sub}</small></article>}
function SectionHeading({eyebrow,title,description,action}){return <div className="section-heading"><div><span className="eyebrow">{eyebrow}</span><h2>{title}</h2>{description&&<p>{description}</p>}</div>{action}</div>}
function Empty({icon:Icon=ClipboardList,title,detail}){return <div className="empty-state"><span><Icon size={22}/></span><b>{title}</b><p>{detail}</p></div>}
function Table({headers,children}){return <div className="table-frame"><div className="table-scroll"><table><thead><tr>{headers.map(h=><th key={h}>{h}</th>)}</tr></thead><tbody>{children}</tbody></table></div></div>}
function Timetable({data}){
 const [view,setView]=useState('week');
 const [selectedDay,setSelectedDay]=useState(1);
 const findRows=(v,depth=0)=>{if(Array.isArray(v))return v;if(!v||typeof v!=='object'||depth>4)return [];for(const x of Object.values(v)){if(Array.isArray(x)&&x.length&&typeof x[0]==='object')return x;}for(const x of Object.values(v)){const found=findRows(x,depth+1);if(found.length)return found;}return [];};
 const rows=findRows(data?.raw??data);
 const days=[['Monday',1],['Tuesday',2],['Wednesday',3],['Thursday',4],['Friday',5],['Saturday',6]];
 const read=(r,...keys)=>{for(const k of keys){const key=Object.keys(r||{}).find(x=>x.toLowerCase()===k.toLowerCase());if(key&&r[key]!=null)return r[key]}return null};
 const time=v=>{if(!v)return 'Time TBA';const m=String(v).match(/^(\d{1,2}):(\d{2})/);if(!m)return String(v);const h=+m[1];return `${h%12||12}:${m[2]} ${h>=12?'PM':'AM'}`};
 if(!rows.length)return <Empty icon={CalendarDays} title="No timetable returned" detail="The current ERP session has no timetable records available."/>;
 const classes=rows.filter(r=>Number(read(r,'HourType'))===1);
 const dayRows=id=>rows.filter(r=>Number(read(r,'DayId'))===id).sort((a,b)=>String(read(a,'TimeFrom')||'').localeCompare(String(read(b,'TimeFrom')||'')));
 const renderItems=list=>list.length?list.map((r,i)=>{const isBreak=Number(read(r,'HourType'))!==1;return <article className={isBreak?'lane-break':'lane-class'} key={i}><small>{time(read(r,'TimeFrom'))} – {time(read(r,'TimeTo'))}</small><b>{isBreak?(Number(read(r,'HourType'))===3?'Lunch break':'Break'):(read(r,'SubjectName')||'Class')}</b>{!isBreak&&<span>{read(r,'SubjectCode')||'Subject'} · {read(r,'Hour','Period')??'—'}</span>}</article>}):<div className="lane-empty">No classes scheduled</div>;
 return <div className="timetable-board"><div className="timetable-toolbar"><div className="timetable-meta"><span><b>{classes.length}</b> scheduled periods</span><span>Imported from your linked ERP session</span></div><div className="view-switch"><button className={view==='week'?'active':''} onClick={()=>setView('week')}>Week view</button><button className={view==='day'?'active':''} onClick={()=>setView('day')}>Day view</button></div></div>{view==='week'?<div className="week-grid">{days.map(([name,id])=>{const list=dayRows(id);return <section className="day-lane" key={id}><header><span>{name.slice(0,3).toUpperCase()}</span><b>{name}</b><small>{list.filter(r=>Number(read(r,'HourType'))===1).length} periods</small></header><div className="lane-items">{renderItems(list)}</div></section>})}</div>:<section className="day-view"><div className="day-tabs">{days.map(([name,id])=><button key={id} className={selectedDay===id?'active':''} onClick={()=>setSelectedDay(id)}>{name.slice(0,3)}</button>)}</div><div className="day-view-heading"><div><span className="eyebrow">DAILY SCHEDULE</span><h3>{days.find(([,id])=>id===selectedDay)?.[0]}</h3></div><span className="data-tag">{dayRows(selectedDay).filter(r=>Number(read(r,'HourType'))===1).length} CLASSES</span></div><div className="day-timeline">{renderItems(dayRows(selectedDay))}</div></section>}</div>;
}
function App(){
 const [logged,setLogged]=useState(false),[student,setStudent]=useState(null),[mode,setMode]=useState('erp'),[page,setPage]=useState('Home'),[dark,setDark]=useState(()=>{try{return localStorage.getItem('sathyabama-theme')!=='light'}catch{return true}}),[railOpen,setRailOpen]=useState(false);
 const [attendance,setAttendance]=useState(null),[subjectAttendance,setSubjectAttendance]=useState(null),[timetable,setTimetable]=useState(null),[academicData,setAcademicData]=useState(null),[hallTicket,setHallTicket]=useState(null),[profileStatus,setProfileStatus]=useState('');
 const [loading,setLoading]=useState(false),[flow,setFlow]=useState('idle'),[error,setError]=useState(''),[help,setHelp]=useState(false),[manualCode,setManualCode]=useState('');
 const [chat,setChat]=useState([{role:'assistant',content:'Hi, I’m SIST AI. Ask me about subjects, exam preparation or study planning.'}]),[chatInput,setChatInput]=useState(''),[chatBusy,setChatBusy]=useState(false),[chatError,setChatError]=useState('');
 const [planner,setPlanner]=useState({cgpa:'',done:'',left:'',target:'8'});
 const [search,setSearch]=useState('');
 const popup=useRef(null),poll=useRef(null),timeout=useRef(null),chatEnd=useRef(null);
 useEffect(()=>{document.documentElement.dataset.theme=dark?'dark':'light';try{localStorage.setItem('sathyabama-theme',dark?'dark':'light')}catch{}},[dark]);
 const live=mode==='erp';
 const subjects=getArray(subjectAttendance?.subjects);
 const totals=subjects.reduce((a,s)=>({present:a.present+(Number(s.present)||0),total:a.total+(Number(s.total)||0)}),{present:0,total:0});
 const subjectPct=totals.total?Math.round(totals.present/totals.total*1000)/10:null;
 const attendancePct=attendance?.kind==='daily-summary'?attendance.summary?.percentage:subjectPct;
 const semesterGroups=getArray(academicData?.semesterResults?.semesters||academicData?.semesterResults?.data?.semesters);
 const allResults=semesterGroups.flatMap(s=>getArray(s.subjects).map(r=>({...r,semester:s.semester,academicYear:s.academicYear,period:s.period})));
 const latestBySubject=new Map();
 allResults.forEach(r=>{const key=String(r.subjectCode||r.subject||'').trim().toUpperCase();if(!key)return;const prev=latestBySubject.get(key);const rank=x=>(Number(String(x.academicYear||'').match(/\d{4}/)?.[0])||0)*100000+(Number(x.academicMonthId)||0)*100+(Number(x.semester)||0);if(!prev||rank(r)>=rank(prev))latestBySubject.set(key,r)});
 const arrears=[...latestBySubject.values()].filter(r=>['RA','FAIL','F','ARREAR'].includes(String(r.result||'').trim().toUpperCase()));
 const requiredGpa=useMemo(()=>{const c=+planner.cgpa,d=+planner.done,l=+planner.left,t=+planner.target;if(![c,d,l,t].every(Number.isFinite)||d<=0||l<=0)return null;return ((t*(d+l))-(c*d))/l},[planner]);
 const nav=(name)=>{setPage(name);setRailOpen(false)};
 function stopPolling(){clearInterval(poll.current);clearTimeout(timeout.current)}
 async function loadDashboard(){
  const p=await fetch('/api/student/me',{credentials:'include'}),pd=await p.json();if(!p.ok)throw new Error(pd.error||'Could not load student profile.');
  setMode(pd.mode);setStudent(pd.student);setProfileStatus(pd.profileStatus||'');
  const [a,s,t,c,sem,h]=await Promise.all([
   fetch('/api/student/attendance',{credentials:'include'}).then(r=>r.json()).catch(()=>null),
   fetch('/api/student/attendance-subjects',{credentials:'include'}).then(r=>r.json()).catch(()=>null),
   fetch('/api/student/timetable',{credentials:'include'}).then(r=>r.json()).catch(()=>null),
   fetch('/api/student/cae-results',{credentials:'include'}).then(r=>r.json()).catch(()=>null),
   fetch('/api/student/semester-results',{credentials:'include'}).then(r=>r.json()).catch(()=>null),
   fetch('/api/student/hall-ticket',{credentials:'include'}).then(r=>r.json()).catch(()=>null)
  ]);
  setAttendance(a);setSubjectAttendance(s);setTimetable(t);setHallTicket(h);setAcademicData({cae:c,semesterResults:sem});setLogged(true);
 }
 async function beginSignIn(){setError('');setHelp(false);setFlow('opening');try{const r=await fetch('/api/link/start',{method:'POST',credentials:'include'}),d=await r.json();if(!r.ok)throw new Error(d.error||'Could not start sign-in.');setManualCode(d.code);const w=window.open(ERP_URL,d.code,'width=480,height=640');if(!w){setFlow('error');setError('Your browser blocked the sign-in window. Allow pop-ups and try again.');return}popup.current=w;setFlow('waiting');poll.current=setInterval(async()=>{try{const s=await fetch('/api/link/status',{credentials:'include'}).then(x=>x.json());if(s.linked){stopPolling();setFlow('connecting');try{w.close()}catch{};await loadDashboard();setFlow('idle');return}}catch{}if(w.closed) {stopPolling();setFlow(f=>f==='waiting'?'cancelled':f)}},1200);timeout.current=setTimeout(()=>{stopPolling();setFlow(f=>f==='waiting'?'timeout':f)},(d.expiresInSeconds||300)*1000)}catch(e){setFlow('error');setError(e.message)}}
 async function logout(){await fetch('/api/auth/logout',{method:'POST',credentials:'include'}).catch(()=>{});setLogged(false);setStudent(null);setPage('Home');setFlow('idle')}
 useEffect(()=>()=>stopPolling(),[]);
 useEffect(()=>{fetch('/api/link/status',{credentials:'include'}).then(r=>r.ok?r.json():null).then(s=>{if(s?.linked)loadDashboard().catch(()=>{})}).catch(()=>{})},[]);
 async function refresh(){setLoading(true);try{await loadDashboard()}catch(e){setError(e.message)}finally{setLoading(false)}}
 function buildAiContext(){
  const safeSubjects=subjects.slice(0,80).map(x=>({subject:String(x.name||x.subject||'').slice(0,120),code:String(x.code||x.subjectCode||'').slice(0,40),present:Number(x.present)||0,total:Number(x.total)||0,percentage:Number(x.percentage??(x.total?100*(Number(x.present)||0)/Number(x.total):0))||0}));
  const safeSemesters=semesterGroups.slice(0,12).map(g=>({semester:g.semester,academicYear:g.academicYear,period:g.period,subjects:getArray(g.subjects).slice(0,80).map(r=>({subject:String(r.subject||'').slice(0,120),code:String(r.subjectCode||'').slice(0,40),internal:r.internalMark,external:r.externalMark,total:r.totalMark,result:String(r.result||'').slice(0,20)}))}));
  const caeRows=getArray(academicData?.cae?.cae||academicData?.cae?.data?.cae||academicData?.cae).slice(0,100).map(r=>({subject:String(r.subject||'').slice(0,120),code:String(r.subjectCode||'').slice(0,40),assessment:r.caeType,marks:r.marks,result:String(r.result||'').slice(0,20)}));
  const timetableRows=Array.isArray(timetable?.raw)?timetable.raw.slice(0,60).map(r=>({day:r.DayName||r.Day||r.DayId,subject:r.SubjectName||r.Subject||'',code:r.SubjectCode||'',from:r.TimeFrom||'',to:r.TimeTo||'',hour:r.Hour||r.Period||'',type:r.HourType})):[];
  return {source:'currently loaded portal data',attendance:{overallPercentage:attendancePct,subjects:safeSubjects},semesterResults:safeSemesters,caeResults:caeRows,timetable:timetableRows};
 }
 async function sendChat(e){e?.preventDefault();const prompt=chatInput.trim();if(!prompt||chatBusy)return;const next=[...chat,{role:'user',content:prompt}];setChat(next);setChatInput('');setChatBusy(true);setChatError('');try{const r=await fetch('/api/ai/chat',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:prompt,history:next.slice(-9),academicContext:buildAiContext()})}),d=await r.json();if(!r.ok)throw new Error(d.error||'AI assistant unavailable.');setChat(v=>[...v,{role:'assistant',content:d.reply}])}catch(e){setChatError(e.message)}finally{setChatBusy(false)}}
 useEffect(()=>{chatEnd.current?.scrollIntoView({behavior:'smooth'})},[chat,chatBusy]);
 if(!logged)return <Login flow={flow} error={error} help={help} setHelp={setHelp} code={manualCode} begin={beginSignIn}/>;
 const filteredSubjects=subjects.filter(s=>`${s.name} ${s.code}`.toLowerCase().includes(search.toLowerCase()));
 const pageTitle=page==='Home'?'Your campus, at a glance':page==='Results'?'Academic record':page==='Profile'?'Student profile':page;
 return <div className="portal-frame">
  <aside className={`nav-rail ${railOpen?'expanded':''}`}>
   <div className="rail-brand"><span className="brand-monogram"><GraduationCap size={21}/></span>{railOpen&&<span><b>SATHYABAMA</b><small>STUDENT SPACE</small></span>}<button className="rail-toggle" onClick={()=>setRailOpen(v=>!v)}>{railOpen?<PanelLeftClose size={17}/>:<PanelLeftOpen size={17}/>}</button></div>
   <nav>{NAV.map(group=><div className="rail-group" key={group.group}>{railOpen&&<small className="rail-label">{group.group}</small>}{group.items.map(([name,Icon])=><button key={name} title={name} className={`rail-link ${page===name?'selected':''}`} onClick={()=>nav(name)}><Icon size={19}/>{railOpen&&<span>{name}</span>}{page===name&&<i/>}</button>)}</div>)}</nav>
   <div className="rail-bottom"><button className="rail-link" title="Switch theme" onClick={()=>setDark(v=>!v)}>{dark?<Sun size={19}/>:<Moon size={19}/>}{railOpen&&<span>{dark?'Light appearance':'Dark appearance'}</span>}</button><button className="rail-link" title="Sign out" onClick={logout}><LogOut size={19}/>{railOpen&&<span>Sign out</span>}</button><div className="rail-user"><span>{initials(student?.name)}</span>{railOpen&&<div><b>{student?.name||'Student'}</b><small>{student?.registerNumber||'ERP account'}</small></div>}</div></div>
  </aside>
  <main className="workspace">
   <header className="workspace-header"><div className="header-left"><button className="mobile-rail-toggle" onClick={()=>setRailOpen(v=>!v)}><Menu size={19}/></button><div className="breadcrumb">STUDENT SPACE <span>/</span> {page.toUpperCase()}</div></div><div className="header-tools"><span className={`connection ${live?'connected':''}`}><i/>{live?'ERP CONNECTED':'PREVIEW MODE'}</span><button className="round-tool" onClick={refresh} title="Refresh data"><RefreshCw size={16} className={loading?'spin':''}/></button><button className="profile-trigger" onClick={()=>nav('Profile')}><span>{initials(student?.name)}</span><b>{student?.name?.split(' ')[0]||'Student'}</b><ChevronDown size={14}/></button></div></header>
   <div className="page-wrap">
    {page==='Home'&&<>
     <section className="home-intro"><div><span className="eyebrow">{new Intl.DateTimeFormat('en-IN',{weekday:'long'}).format(new Date()).toUpperCase()} · STUDENT WORKSPACE</span><h1>Good to see you,<br/><em>{student?.name?.split(' ')[0]||'Student'}.</em></h1><p>Your academic life, organised around what matters today.</p><div className="intro-actions"><button className="button-primary" onClick={()=>nav('Timetable')}>View my schedule <ArrowUpRight size={16}/></button><span className="term-chip">{student?.programme||'Student programme'}{student?.semester?` · Semester ${student.semester}`:''}</span></div></div><div className="intro-visual"><div className="visual-orbit orbit-a"/><div className="visual-orbit orbit-b"/><div className="visual-disc"><GraduationCap size={48}/></div><span className="visual-note note-one">LEARN</span><span className="visual-note note-two">GROW</span></div></section>
     <div className="home-layout"><section className="home-main"><div className="section-heading compact"><div><span className="eyebrow">YOUR SNAPSHOT</span><h2>At a glance</h2></div><span className="muted-caption">Live student records</span></div><div className="stats-grid"><Stat label="ATTENDANCE" value={attendancePct==null?'—':`${attendancePct}%`} sub={attendancePct==null?'Waiting for ERP data':attendancePct>=80?'Meeting the 80% threshold':'Below the 80% threshold'} icon={Activity} accent="gold"/><Stat label="SUBJECTS" value={subjects.length||'—'} sub="Current semester subjects" icon={BookOpen} accent="sage"/><Stat label="SEMESTERS FOUND" value={semesterGroups.length||'—'} sub="Academic history from ERP" icon={CalendarCheck} accent="slate"/><Stat label="OPEN ARREARS" value={live?(arrears.length||0):'—'} sub="Based on returned result status" icon={AlertCircle} accent="rose"/></div>
      <section className="surface attendance-card"><SectionHeading eyebrow="ATTENDANCE MONITOR" title="Keep your attendance in range" description="A quick read of your current semester record." action={<button className="text-action" onClick={()=>nav('Attendance')}>Full report <ArrowRight size={15}/></button>}/><div className="attendance-summary"><div className="attendance-donut" style={{'--value':`${pct(attendancePct)}%`}}><div><b>{attendancePct==null?'—':`${attendancePct}%`}</b><small>ATTENDANCE</small></div></div><div className="attendance-insights"><div><span className="insight-dot gold-dot"/><span>At / above 80%</span><b>{subjects.filter(s=>Number(s.percentage)>=80).length}</b></div><div><span className="insight-dot rose-dot"/><span>Below 80%</span><b>{subjects.filter(s=>Number(s.percentage)<80).length}</b></div><div><span className="insight-dot neutral-dot"/><span>Subjects tracked</span><b>{subjects.length||'—'}</b></div><p>Attendance is calculated from the available ERP records. Confirm official requirements with your department.</p></div></div></section>
      <section className="surface activity-card"><SectionHeading eyebrow="ACADEMIC RECORD" title="Your recent results" description="Published semester examination records." action={<button className="text-action" onClick={()=>nav('Results')}>Open results <ArrowRight size={15}/></button>}/>{allResults.length?<div className="recent-results">{semesterGroups.slice().reverse().slice(0,3).map((g,i)=><div className="result-period" key={`${g.semester}-${g.academicYear}-${i}`}><div className="period-marker">S{g.semester}</div><div className="period-copy"><b>Semester {g.semester}</b><small>{g.academicYear} · {g.period||'Examination period'}</small></div><span>{getArray(g.subjects).length} subjects</span><ArrowUpRight size={15}/></div>)}</div>:<Empty icon={BookOpenCheck} title="Your results will appear here" detail={academicData?.semesterResults?.message||'No published semester results were returned for this account yet.'}/>}</section>
     </section><aside className="home-aside"><section className="surface identity-card"><div className="identity-head"><span className="eyebrow">STUDENT IDENTITY</span><span className="verified-mark"><ShieldCheck size={15}/> VERIFIED SESSION</span></div><div className="identity-avatar">{initials(student?.name)}</div><h3>{student?.name||'Student'}</h3><p>{student?.programme||'Programme unavailable'}</p><div className="identity-number"><span>REGISTER NUMBER</span><b>{student?.registerNumber||'—'}</b></div><div className="identity-meta"><div><span>SEMESTER</span><b>{student?.semester||'—'}</b></div><div><span>SECTION</span><b>{student?.section||'—'}</b></div></div><button className="identity-link" onClick={()=>nav('Profile')}>View student profile <ArrowUpRight size={15}/></button></section>
      <section className="surface quick-panel"><SectionHeading eyebrow="QUICK ACCESS" title="Jump back in"/><div className="quick-links"><button onClick={()=>nav('Timetable')}><span className="quick-icon"><CalendarDays size={17}/></span><span><b>Class timetable</b><small>See your weekly schedule</small></span><ArrowUpRight size={15}/></button><button onClick={()=>nav('Results')}><span className="quick-icon"><BookOpen size={17}/></span><span><b>Academic results</b><small>CAE and semester marks</small></span><ArrowUpRight size={15}/></button><button onClick={()=>nav('SIST AI')}><span className="quick-icon"><Sparkles size={17}/></span><span><b>Ask SIST AI</b><small>Study and exam support</small></span><ArrowUpRight size={15}/></button><button onClick={()=>nav('Hall ticket')}><span className="quick-icon"><FileBadge size={17}/></span><span><b>Hall ticket</b><small>Examination document</small></span><ArrowUpRight size={15}/></button></div></section>
      <div className="notice-card"><span><Lock size={16}/></span><div><b>Your data stays session-based</b><p>This portal displays records returned through your linked ERP session. It does not ask for your ERP password.</p></div></div></aside></div>
    </>}
    {page==='Attendance'&&<><SectionHeading eyebrow="CAMPUS / ATTENDANCE" title="Attendance centre" description="Review your attendance totals and subject-level position." action={<button className="button-secondary" onClick={()=>window.print()}><Download size={15}/> Export report</button>}/>{attendance?.kind==='daily-summary'&&<div className="stats-grid attendance-stats"><Stat label="OVERALL" value={`${attendance.summary?.percentage??'—'}${attendance.summary?.percentage!=null?'%':''}`} sub="Working-day attendance" icon={Activity}/><Stat label="PRESENT DAYS" value={attendance.summary?.presentDays??'—'} sub="Days marked present" icon={CheckCircle2} accent="sage"/><Stat label="ABSENT DAYS" value={attendance.summary?.absentDays??'—'} sub="Days marked absent" icon={AlertCircle} accent="rose"/><Stat label="WORKING DAYS" value={attendance.summary?.totalDays??'—'} sub="In the returned period" icon={CalendarDays} accent="slate"/></div>}{subjects.length?<section className="surface data-surface"><SectionHeading eyebrow="SUBJECT BREAKDOWN" title="Attendance by subject" description="Computed using your timetable and daily attendance record." action={<span className="data-tag">LIVE ERP</span>}/><div className="filter-row"><label className="search-box"><Search size={15}/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Search subject or code"/></label><span>{filteredSubjects.length} subjects</span></div><Table headers={['SUBJECT','ATTENDED','TOTAL','ATTENDANCE','STATUS']}>{filteredSubjects.map((s,i)=><tr key={s.code||i}><td><b>{s.name||'Subject'}</b><small className="cell-sub">{s.code||'—'}</small></td><td>{s.present??'—'}</td><td>{s.total??'—'}</td><td><div className="inline-progress"><b>{s.percentage==null?'—':`${s.percentage}%`}</b><span><i style={{width:`${pct(s.percentage)}%`}}/></span></div></td><td><span className={`status-tag ${Number(s.percentage)>=80?'good':Number(s.percentage)>=75?'watch':'bad'}`}>{Number(s.percentage)>=80?'On track':Number(s.percentage)>=75?'Watch':'Attention'}</span></td></tr>)}</Table><div className="table-footnote"><ShieldCheck size={15}/> Minimum threshold shown as 80%. Verify your programme's official attendance regulations.</div></section>:attendance?.kind==='daily-summary'?<section className="surface data-surface"><SectionHeading eyebrow="ATTENDANCE HISTORY" title="Absent dates"/><div className="date-pills">{getArray(attendance.summary?.absentDates).length?attendance.summary.absentDates.map(d=><span key={d}>{d}</span>):'No absent dates returned.'}</div><p className="helper-copy">The ERP provides daily attendance for this account; subject-wise data is not currently available.</p></section>:<Empty icon={Activity} title="Attendance data unavailable" detail={attendance?.error||attendance?.message||'No attendance records were returned for this session.'}/>}</>}
    {page==='Timetable'&&<><SectionHeading eyebrow="CAMPUS / SCHEDULE" title="Weekly timetable" description="Your class schedule, arranged by teaching day." action={<span className="data-tag">ERP SCHEDULE</span>}/><Timetable data={timetable}/></>}
    {page==='Results'&&<ResultsPage data={academicData} refresh={refresh} loading={loading} groups={semesterGroups} arrears={arrears} planner={planner} setPlanner={setPlanner} requiredGpa={requiredGpa} navigate={nav}/>}
    {page==='SIST AI'&&<section className="ai-workspace"><div className="ai-intro"><span className="ai-emblem"><Brain size={25}/></span><div><span className="eyebrow">STUDY COMPANION</span><h2>SIST AI</h2><p>Your academic thinking partner for explanations, exam preparation and study planning.</p></div></div><div className="ai-chat surface"><div className="chat-top"><div><b>Conversation</b><small><i/> Ready to help</small></div><button className="button-secondary" onClick={()=>setChat([{role:'assistant',content:'Hi, I’m SIST AI. Ask me about subjects, exam preparation or study planning.'}])}>New chat</button></div><div className="chat-stream">{chat.map((m,i)=><div className={`chat-line ${m.role}`} key={i}><span>{m.role==='assistant'?<Brain size={16}/>:initials(student?.name)}</span><p>{m.content}</p></div>)}{chatBusy&&<div className="chat-line assistant"><span><Brain size={16}/></span><p>Thinking…</p></div>}<div ref={chatEnd}/></div>{chatError&&<p className="chat-error">{chatError}</p>}<form className="chat-entry" onSubmit={sendChat}><input value={chatInput} onChange={e=>setChatInput(e.target.value)} placeholder="Ask a question or describe what you're learning…" disabled={chatBusy}/><button disabled={chatBusy||!chatInput.trim()}><Send size={17}/></button></form><small className="chat-legal">AI can make mistakes. Verify official marks and academic regulations with the university.</small></div></section>}
    {page==='Hall ticket'&&<><SectionHeading eyebrow="EXAMINATIONS / DOCUMENTS" title="Hall ticket" description="Access hall-ticket information returned by your ERP session."/><section className="surface document-panel">{hallTicket?.raw?<pre>{JSON.stringify(hallTicket.raw,null,2)}</pre>:<Empty icon={FileBadge} title="No hall-ticket data available" detail={hallTicket?.message||hallTicket?.error||'The hall-ticket endpoint may not be configured or published for this account.'}/>}</section></>}
    {page==='Profile'&&<><SectionHeading eyebrow="ACCOUNT / STUDENT IDENTITY" title="Your profile" description="Academic identity fields returned by the official ERP."/><div className="profile-layout"><section className="surface profile-identity"><div className="large-avatar">{initials(student?.name)}</div><h2>{student?.name||'Student'}</h2><p>{student?.programme||'Programme not available'}</p><span className="data-tag">{live?'ERP SESSION LINKED':'PREVIEW'}</span></section><section className="surface profile-fields"><h3>Academic information</h3>{[['Register number',student?.registerNumber],['Programme',student?.programme],['Semester',student?.semester],['Section',student?.section],['Profile status',profileStatus||'—']].map(([k,v])=><div className="profile-field" key={k}><span>{k}</span><b>{v||'Not returned by ERP'}</b></div>)}</section></div></>}
    {page==='Settings'&&<><SectionHeading eyebrow="ACCOUNT / PREFERENCES" title="Workspace settings" description="Adjust how the student portal looks and behaves."/><section className="surface settings-list"><div><span className="settings-icon"><Sun size={18}/></span><div><b>Appearance</b><small>Choose a comfortable workspace theme.</small></div><button className="button-secondary" onClick={()=>setDark(v=>!v)}>{dark?'Switch to light':'Switch to dark'}</button></div><div><span className="settings-icon"><RefreshCw size={18}/></span><div><b>Refresh ERP records</b><small>Reload profile, attendance, timetable and academic data.</small></div><button className="button-secondary" onClick={refresh} disabled={loading}>{loading?'Refreshing…':'Refresh now'}</button></div><div><span className="settings-icon"><LogOut size={18}/></span><div><b>End session</b><small>Sign out of this student portal session.</small></div><button className="button-danger" onClick={logout}>Sign out</button></div></section></>}
    <footer className="workspace-footer"><span>SATHYABAMA STUDENT SPACE</span><span>Independent student interface · Not an official university website</span></footer>
   </div>
  </main>
 </div>
}
function Login({flow,error,help,setHelp,code,begin}){return <div className="login-shell"><section className="login-left"><div className="brand-mark"><span className="crest"><GraduationCap size={20}/></span><div><b>SATHYABAMA</b><small>INSTITUTE OF SCIENCE AND TECHNOLOGY</small></div></div><div className="login-copy"><h1>Your campus.<br/><em>One sign-in away.</em></h1><p>A calmer, clearer way to stay connected with your academic life — attendance, timetable, academics and more, drawn straight from your ERP account.</p><div className="trust-row"><span><ShieldCheck size={15}/> You sign in on the ERP itself</span><span><Lock size={15}/> Your password never touches this site</span></div></div><div className="left-foot"><span>© 2026 Sathyabama Student Portal</span><span>Independent student-facing interface</span></div></section><section className="login-right"><div className="mobile-brand brand-mark"><span className="crest"><GraduationCap size={18}/></span><div><b>SATHYABAMA</b><small>STUDENT PORTAL</small></div></div><div className="panel-kicker">SECURE STUDENT ACCESS</div><h2>Sign in through the official ERP.</h2><p className="login-sub">Continue to Sathyabama's original ERP, complete its normal sign-in and security check, then return here. Your ERP password is never entered into this portal.</p><div className="signin-card">{flow==='opening'||flow==='waiting'||flow==='connecting'?<><div className="flow-steps">{STEPS.map((step,i)=>{const active=flow==='opening'?0:flow==='waiting'?1:2;const state=i<active?'done':i===active?'active':'';return <div className={`flow-step ${state}`} key={step.title}><span className="flow-num">{state==='done'?<CheckCircle2 size={14}/>:i+1}</span><div className="flow-text"><b>{step.title}</b><span>{step.detail}</span></div></div>})}</div>{flow==='waiting'&&<button className="helper-toggle" onClick={()=>setHelp(v=>!v)}>Having trouble completing sign-in?</button>}{help&&<div className="helper-box">Open the Portal Link browser extension and enter this one-time code: <code>{code}</code></div>}</>:<><button className="signin-cta" onClick={begin}><ExternalLink size={17}/> Sign in through original ERP <ArrowUpRight size={16}/></button>{(error||flow==='timeout'||flow==='cancelled')&&<div className="banner warn"><AlertCircle size={16}/><span>{error||(flow==='timeout'?'The sign-in window expired. Start again to generate a new secure link.':'The ERP window was closed before linking finished.')}</span></div>}</>}<div className="signin-note"><ShieldCheck size={14}/><span>You'll sign in directly on erp.sathyabama.ac.in. This portal does not ask for or store your ERP password.</span></div></div><div className="login-bottom"><span>Need help? Contact your department office.</span><span>PRIVACY · SUPPORT</span></div></section></div>}
function ResultsPage({data,refresh,loading,groups,arrears,planner,setPlanner,requiredGpa,navigate}){const cae=getArray(data?.cae?.cae||data?.cae?.data?.cae||data?.cae);const field=(label,key,placeholder)=><label className="planner-field"><span>{label}</span><input type="number" min="0" step="any" placeholder={placeholder} value={planner[key]} onChange={e=>setPlanner(p=>({...p,[key]:e.target.value}))}/></label>;return <div className="results-page"><SectionHeading eyebrow="ACADEMICS / PERFORMANCE" title="Academic record" description="Your CAE assessments, semester results and planning tools." action={<button className="button-secondary" onClick={refresh} disabled={loading}><RefreshCw size={15}/> {loading?'Refreshing…':'Refresh records'}</button>}/><div className="stats-grid result-stats"><Stat label="SEMESTERS" value={groups.length||'—'} sub="Returned by ERP" icon={CalendarDays}/><Stat label="SUBJECT RECORDS" value={groups.reduce((n,g)=>n+getArray(g.subjects).length,0)||'—'} sub="Across available semesters" icon={BookOpen} accent="sage"/><Stat label="ARREAR FLAGS" value={arrears.length} sub="RA / fail statuses in returned rows" icon={AlertCircle} accent="rose"/><Stat label="CAE ENTRIES" value={cae.length||'—'} sub="Continuous assessment records" icon={ClipboardList} accent="slate"/></div>
 <section className="surface result-surface"><SectionHeading eyebrow="CONTINUOUS ASSESSMENT" title="CAE marks" description="Marks by subject and assessment type."/><div className="cae-table">{cae.length?<Table headers={['SUBJECT','CAE 1','CAE 1 STATUS','CAE 2','CAE 2 STATUS']}>{Array.from(new Map(cae.map(r=>[r.subjectCode,{code:r.subjectCode,subject:r.subject,one:cae.find(x=>x.subjectCode===r.subjectCode&&x.caeType===1),two:cae.find(x=>x.subjectCode===r.subjectCode&&x.caeType===2)}])).values()).map(r=><tr key={r.code}><td><b>{r.subject||'Subject'}</b><small className="cell-sub">{r.code}</small></td><td>{r.one?.marks??'—'} / 50</td><td>{r.one?.result||'—'}</td><td>{r.two?.marks??'—'} / 50</td><td>{r.two?.result||'—'}</td></tr>)}</Table>:<Empty icon={ClipboardList} title="No CAE marks returned" detail={data?.cae?.error||'No CAE entries are available for the current ERP period.'}/>}</div></section>
 <section className="surface result-surface"><SectionHeading eyebrow="UNIVERSITY EXAMINATIONS" title="Semester results" description="Grouped using the academic periods returned for this student."/>{groups.length?groups.map((g,i)=><div className="semester-block" key={`${g.semester}-${g.academicYear}-${i}`}><div className="semester-heading"><div><span>SEMESTER {g.semester}</span><b>{g.academicYear} · {g.period||'Exam period'}</b></div><span>{getArray(g.subjects).length} subjects</span></div><Table headers={['SUBJECT','INTERNAL','EXTERNAL','TOTAL','RESULT']}>{getArray(g.subjects).map((r,j)=><tr key={`${r.subjectCode}-${j}`}><td><b>{r.subject||'Subject'}</b><small className="cell-sub">{r.subjectCode||'—'}</small></td><td>{r.internalMark??'—'}</td><td>{r.externalMark??'—'}</td><td><b>{r.totalMark??'—'}</b></td><td><span className={`status-tag ${String(r.result).toUpperCase()==='PASS'?'good':'bad'}`}>{r.result||'—'}</span></td></tr>)}</Table></div>):<Empty icon={BookOpenCheck} title="No semester records returned" detail={data?.semesterResults?.message||'Semester results are not available for this linked ERP profile.'}/>}</section>
 <section className="surface arrear-surface"><SectionHeading eyebrow="SUBJECT FOLLOW-UP" title="Arrear tracker" description="Rows marked RA or fail in the available semester results."/>{arrears.length?<div className="arrear-list">{arrears.map((r,i)=><div key={`${r.subjectCode}-${i}`}><span className="arrear-symbol"><AlertCircle size={17}/></span><div><b>{r.subject||r.subjectCode||'Subject'}</b><small>Semester {r.semester} · {r.academicYear}</small></div><span className="status-tag bad">{r.result}</span></div>)}</div>:<Empty icon={CheckCircle2} title="No arrear flags in returned records" detail="This only reflects the semester results currently returned by the ERP; it is not a complete clearance certificate."/>}</section>
 <section className="surface planner-surface"><SectionHeading eyebrow="PLAN YOUR NEXT MILESTONE" title="CGPA scenario planner" description="Estimate a required average across remaining credits."/><div className="planner-grid">{field('Current CGPA','cgpa','e.g. 7.20')}{field('Credits completed','done','e.g. 60')}{field('Credits remaining','left','e.g. 100')}{field('Target CGPA','target','e.g. 8.00')}</div><div className="planner-answer"><div><span>REQUIRED AVERAGE GPA</span><b>{requiredGpa==null?'Enter all four values':requiredGpa>10?'Above 10.00':requiredGpa<0?'Target already exceeded':requiredGpa.toFixed(2)}</b><small>Estimate only; official CGPA requires the university's credit and grade-point rules.</small></div><Calculator size={25}/></div></section><div className="ai-callout"><span><Brain size={20}/></span><div><b>Want help planning your semester?</b><small>Ask SIST AI to explain topics or work through a study plan.</small></div><button className="text-action" onClick={()=>navigate('SIST AI')}>Open assistant <ArrowRight size={15}/></button></div></div>}

createRoot(document.getElementById('root')).render(<App/>);
